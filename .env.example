# ALM Biometric Attendance & Payroll System - Environment Configuration
# IMPORTANT: Never commit this file to version control

# Email Configuration (Brevo - formerly Sendinblue)
# Get your API key from: https://app.brevo.com/account/security/api
BREVO_API_KEY=your-brevo-api-key-here
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=ALM Biometrics System

# Database Configuration
DB_HOST=localhost
DB_NAME=alm_biometrics
DB_USER=root
DB_PASS=

# Encryption Key for Biometric Data (Generate a random 32-character key)
# You can generate one using: openssl rand -hex 32
ENCRYPTION_KEY=change-this-to-a-random-32-character-key

# Security Settings
SESSION_TIMEOUT=3600  # 1 hour in seconds
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15  # minutes
PASSWORD_MIN_LENGTH=8

# 2FA Settings (Optional)
2FA_ENABLED=false
2FA_ISSUER_NAME=ALM Biometrics

# Backup Settings
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Data Retention
ATTENDANCE_RETENTION_YEARS=2
PAYROLL_RETENTION_YEARS=5
