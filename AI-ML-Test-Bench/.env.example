# ALM Biometric System - Environment Configuration
# Copy this file to .env and update values for your environment

# Database Configuration
DB_HOST=localhost
DB_NAME=alm_biometrics
DB_USER=root
DB_PASS=

# Optional: Database Charset (default: utf8mb4)
DB_CHARSET=utf8mb4

# PORTABILITY SETUP:
# 1. Copy entire project to new location (USB/another PC)
# 2. Copy this .env.example → .env
# 3. Update DB credentials above
# 4. Import sql/complete_schema.sql in phpMyAdmin
# 5. Access /AI-ML-Test-Bench/ → Ready!

# XAMPP Default (change for production)
# DB_HOST=localhost
# DB_NAME=your_database_name
# DB_USER=your_db_user
# DB_PASS=your_db_password

# Security Note: Never commit .env with real credentials to git!

