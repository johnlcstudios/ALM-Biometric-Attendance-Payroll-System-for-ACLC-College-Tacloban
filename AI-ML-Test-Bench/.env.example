# ALM Biometric System - Environment Configuration
# Copy this file to .env and update values for your deployment
# This makes the system FULLY PORTABLE across PCs/XAMPP installs

# =====================================================
# DATABASE CONFIGURATION (REQUIRED)
# =====================================================
DB_HOST=localhost
DB_NAME=alm_biometrics
DB_USER=root
DB_PASS=

# =====================================================
# ENCRYPTION (REQUIRED for biometrics)
# =====================================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_32_character_encryption_key_here_abc123def456ghi789jkl

# =====================================================
# EMAIL NOTIFICATIONS (OPTIONAL - for leave/loan alerts)
# =====================================================
BREVO_API_KEY=your_brevo_sendinblue_api_key_here
FROM_EMAIL=noreply@yourcompany.com
COMPANY_NAME=Your Company Name

# =====================================================
# APPLICATION SETTINGS (OPTIONAL)
# =====================================================
APP_URL=http://localhost/AI-ML-Test-Bench
APP_TIMEZONE=Asia/Manila
MAX_FILE_UPLOAD_MB=5

# =====================================================
# SECURITY (OPTIONAL)
# =====================================================
ALLOWED_ORIGINS=*
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=300

# =====================================================
# QUICK START SETUP
# =====================================================
# 1. Copy this file → .env (remove .example)
# 2. Update DB_NAME, DB_USER, DB_PASS for your MySQL
# 3. Generate ENCRYPTION_KEY: openssl rand -hex 32
# 4. Restart Apache: net stop Apache2.4 && net start Apache2.4
# 5. Test: http://localhost/.../signup.php

# =====================================================
# PORTABILITY NOTES
# =====================================================
# ✅ No hardcoded paths
# ✅ Relative uploads/profiles/
# ✅ .env overrides all defaults
# ✅ Works on any XAMPP/WAMP/LAMP + MySQL
# ✅ Multi-tenant (company_code isolation)

# Database must exist first:
# mysql -u root -p -e "CREATE DATABASE alm_biometrics;"
# Then import: AI-ML-Test-Bench/sql/complete_schema.sql
